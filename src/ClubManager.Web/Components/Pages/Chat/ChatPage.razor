@page "/chat"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using Microsoft.AspNetCore.SignalR.Client
@using ClubManager.Models
@using ClubManager.Hubs
@inject ChatService ChatSvc
@inject AppDbContextClubManager Db
@inject AuthenticationStateProvider AuthState
@inject NavigationManager Nav
@implements IAsyncDisposable

<PageTitle>Chat</PageTitle>

<MudText Typo="Typo.h4" GutterBottom="true">Chat</MudText>

<MudGrid Style="height: calc(100vh - 160px);">
    @* Levý panel — seznam vláken *@
    <MudItem xs="12" md="4" Style="height:100%; overflow-y:auto;">
        @foreach (var club in _clubs)
        {
            <MudText Typo="Typo.overline" Class="px-2 pt-2">@club.Name</MudText>
            @foreach (var t in _threads.Where(t => t.ClubId == club.Id))
            {
                <MudPaper Class="@($"pa-2 mb-1 cursor-pointer {(_selectedThread?.Id == t.Id ? "mud-primary-text" : "")}")"
                          Elevation="@(_selectedThread?.Id == t.Id ? 4 : 1)"
                          @onclick="() => SelectThread(t)">
                    <div class="d-flex justify-space-between align-center">
                        <MudText Typo="Typo.body2"><b>@t.Title</b></MudText>
                        <MudChip T="string" Size="Size.Small" Color="Color.Default">@t.ThreadType</MudChip>
                    </div>
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">
                        @t.CreatedAt.ToLocalTime().ToString("d. M. yyyy")
                    </MudText>
                </MudPaper>
            }
        }

        @if (!_clubs.Any())
        {
            <MudAlert Severity="MudBlazor.Severity.Info" Class="mt-4">
                Nejste členem žádného oddílu. <a href="/join">Vstupte kódem</a>.
            </MudAlert>
        }
    </MudItem>

    @* Pravý panel — feed zpráv *@
    <MudItem xs="12" md="8" Style="height:100%; display:flex; flex-direction:column;">
        @if (_selectedThread is null)
        {
            <MudPaper Class="d-flex align-center justify-center" Style="height:100%; flex-grow:1;" Elevation="0">
                <MudText Class="mud-text-secondary">Vyberte vlákno ze seznamu.</MudText>
            </MudPaper>
        }
        else
        {
            @* Hlavička *@
            <MudPaper Class="pa-3 mb-2" Elevation="1">
                <MudText Typo="Typo.h6">@_selectedThread.Title</MudText>
                <MudText Typo="Typo.caption" Class="mud-text-secondary">@_selectedThread.ThreadType</MudText>
            </MudPaper>

            @* Zprávy *@
            <MudPaper Class="pa-3" Style="flex-grow:1; overflow-y:auto;" Elevation="0" @ref="_feedRef">
                @foreach (var msg in _messages)
                {
                    var isMe = msg.SenderUserId == _userId;
                    <div class="@($"d-flex mb-2 {(isMe ? "justify-end" : "")}")">
                        <MudPaper Class="@($"pa-2 {(isMe ? "mud-primary-lighten mud-primary-text" : "mud-grey-lighten-4")}")"
                                  Style="max-width:70%; border-radius:12px;" Elevation="0">
                            @if (!isMe)
                            {
                                <MudText Typo="Typo.caption" Class="mud-text-secondary mb-1">
                                    @(msg.SenderUser?.UserName ?? msg.SenderUserId)
                                </MudText>
                            }
                            <MudText>@msg.Body</MudText>
                            <MudText Typo="Typo.caption" Class="mud-text-secondary mt-1">
                                @msg.CreatedAt.ToLocalTime().ToString("HH:mm")
                            </MudText>
                        </MudPaper>
                    </div>
                }
            </MudPaper>

            @* Input *@
            <MudPaper Class="pa-2 mt-2" Elevation="1">
                <MudGrid>
                    <MudItem xs="10">
                        <MudTextField @bind-Value="_newMessage" Placeholder="Napište zprávu..."
                                      Variant="Variant.Outlined" Lines="1"
                                      OnKeyDown="OnKeyDown" />
                    </MudItem>
                    <MudItem xs="2" Class="d-flex align-center">
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true"
                                   OnClick="Send" Disabled="@string.IsNullOrWhiteSpace(_newMessage)">
                            <MudIcon Icon="@Icons.Material.Filled.Send" />
                        </MudButton>
                    </MudItem>
                </MudGrid>
            </MudPaper>
        }
    </MudItem>
</MudGrid>

@code {
    private string _userId = "";
    private ClubThread? _selectedThread;
    private List<ChatMessage> _messages = [];
    private List<ClubThread> _threads = [];
    private List<Club> _clubs = [];
    private string _newMessage = "";
    private MudPaper _feedRef = null!;
    private HubConnection? _hub;

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthState.GetAuthenticationStateAsync();
        _userId = auth.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value ?? "";

        var memberships = await Db.ClubMembers
            .Include(m => m.OrganizationMember)
            .Include(m => m.Club)
            .Where(m => m.OrganizationMember.UserId == _userId && m.IsActive)
            .ToListAsync();

        _clubs = memberships.Select(m => m.Club).DistinctBy(c => c.Id).ToList();
        foreach (var club in _clubs)
        {
            var threads = await ChatSvc.GetClubThreadsAsync(club.Id);
            _threads.AddRange(threads);
        }

        _hub = new HubConnectionBuilder()
            .WithUrl(Nav.ToAbsoluteUri("/hubs/messaging"))
            .WithAutomaticReconnect()
            .Build();

        _hub.On<ChatMessageDto>("NewMessage", async dto =>
        {
            if (_selectedThread?.Id != dto.ThreadId) return;
            _messages.Add(new ChatMessage
            {
                Id = dto.Id, ThreadId = dto.ThreadId, SenderUserId = dto.SenderUserId,
                Body = dto.Body, CreatedAt = dto.CreatedAt
            });
            await InvokeAsync(StateHasChanged);
        });

        await _hub.StartAsync();
    }

    private async Task SelectThread(ClubThread thread)
    {
        if (_selectedThread is not null && _hub is not null)
            await _hub.SendAsync("LeaveThread", _selectedThread.Id.ToString());

        _selectedThread = thread;
        _messages = await ChatSvc.GetMessagesAsync(thread.Id);

        if (_hub is not null)
            await _hub.SendAsync("JoinThread", thread.Id.ToString());

        StateHasChanged();
    }

    private async Task Send()
    {
        if (string.IsNullOrWhiteSpace(_newMessage) || _selectedThread is null) return;
        await ChatSvc.SendMessageAsync(_selectedThread.Id, _userId, _newMessage.Trim());
        _newMessage = "";
    }

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !e.ShiftKey) await Send();
    }

    public async ValueTask DisposeAsync()
    {
        if (_hub is not null)
        {
            if (_selectedThread is not null)
                await _hub.SendAsync("LeaveThread", _selectedThread.Id.ToString());
            await _hub.DisposeAsync();
        }
    }
}
