@page "/accept-invite"
@rendermode InteractiveServer
@using MercenariesAndBeasts.Infrastructure
@using Microsoft.AspNetCore.Identity
@inject InvitationService InvSvc
@inject UserManager<AppUser> UserMgr
@inject SignInManager<AppUser> SignIn
@inject NavigationManager Nav

<PageTitle>Přijmout pozvánku</PageTitle>

<MudContainer MaxWidth="MaxWidth.Small" Class="mt-8">
    @if (_loading)
    {
        <MudProgressCircular Indeterminate="true" />
    }
    else if (_invitation is null)
    {
        <MudAlert Severity="MudBlazor.Severity.Error">
            Pozvánka nebyla nalezena nebo její platnost vypršela.
        </MudAlert>
        <MudButton Href="/" Variant="Variant.Text" Class="mt-4">Zpět domů</MudButton>
    }
    else
    {
        <MudText Typo="Typo.h5" GutterBottom="true">Přijmout pozvánku</MudText>
        <MudText Class="mb-4">
            Jste zváni do oddílu <strong>@_invitation.Club.Name</strong>
            (@_invitation.Club.Organization.Name) jako @_invitation.Role.
        </MudText>

        <MudText Typo="Typo.subtitle2" Class="mb-2">
            Zadejte vaše přihlašovací údaje pro přijetí pozvánky.
        </MudText>

        <EditForm Model="@_model" OnValidSubmit="DoAccept">
            <DataAnnotationsValidator />
            <MudTextField Label="Jméno" @bind-Value="_model.FirstName" Variant="Variant.Outlined" Class="mb-3"
                          For="@(() => _model.FirstName)" />
            <MudTextField Label="Příjmení" @bind-Value="_model.LastName" Variant="Variant.Outlined" Class="mb-3"
                          For="@(() => _model.LastName)" />
            <MudTextField Label="Email" Value="@_invitation.Email" Variant="Variant.Outlined" Class="mb-3"
                          ReadOnly="true" />
            <MudTextField Label="Heslo" @bind-Value="_model.Password" Variant="Variant.Outlined" Class="mb-3"
                          InputType="InputType.Password" For="@(() => _model.Password)" />

            @if (_error is not null)
            {
                <MudAlert Severity="MudBlazor.Severity.Error" Class="mb-3">@_error</MudAlert>
            }

            <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary"
                       FullWidth="true" Disabled="_submitting">
                @(_submitting ? "Zpracovávám..." : "Přijmout pozvánku")
            </MudButton>
        </EditForm>
    }
</MudContainer>

@code {
    [SupplyParameterFromQuery] public string? Token { get; set; }

    private ClubManager.Models.Invitation? _invitation;
    private AcceptModel _model = new();
    private string? _error;
    private bool _loading = true;
    private bool _submitting;

    protected override async Task OnInitializedAsync()
    {
        if (!string.IsNullOrEmpty(Token))
            _invitation = await InvSvc.GetValidByTokenAsync(Token);
        _loading = false;
    }

    private async Task DoAccept()
    {
        if (_invitation is null || Token is null) return;
        _submitting = true;
        _error = null;

        var existing = await UserMgr.FindByEmailAsync(_invitation.Email);
        if (existing is not null)
        {
            // Uživatel existuje — jen přijmi pozvánku
            var ok = await InvSvc.AcceptAsync(Token, existing.Id);
            if (ok)
            {
                await SignIn.SignInAsync(existing, false);
                Nav.NavigateTo("/clubs");
                return;
            }
            _error = "Přijetí pozvánky selhalo.";
            _submitting = false;
            return;
        }

        var user = new AppUser
        {
            UserName = _invitation.Email,
            Email = _invitation.Email,
            EmailConfirmed = true,
            IsWhitelisted = true
        };
        var result = await UserMgr.CreateAsync(user, _model.Password);
        if (!result.Succeeded)
        {
            _error = string.Join("; ", result.Errors.Select(e => e.Description));
            _submitting = false;
            return;
        }

        await InvSvc.AcceptAsync(Token, user.Id);
        await SignIn.SignInAsync(user, false);
        Nav.NavigateTo("/clubs");
    }

    class AcceptModel
    {
        [System.ComponentModel.DataAnnotations.Required]
        public string FirstName { get; set; } = "";
        [System.ComponentModel.DataAnnotations.Required]
        public string LastName { get; set; } = "";
        [System.ComponentModel.DataAnnotations.Required, System.ComponentModel.DataAnnotations.MinLength(8)]
        public string Password { get; set; } = "";
    }
}
