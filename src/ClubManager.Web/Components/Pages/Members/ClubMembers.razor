@page "/clubs/{ClubId:int}/members"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@inject AppDbContextClubManager Db
@inject InvitationService InvSvc
@inject AuthenticationStateProvider AuthState
@inject ISnackbar Snackbar

<PageTitle>Členové oddílu</PageTitle>

@if (_club is null)
{
    <MudProgressCircular Indeterminate="true" />
}
else
{
    <MudText Typo="Typo.h5" GutterBottom="true">Členové — @_club.Name</MudText>

    @* Kód skupiny *@
    <MudCard Class="mb-4">
        <MudCardContent>
            <MudText Typo="Typo.subtitle1">Kód skupiny</MudText>
            <div class="d-flex align-center gap-3 mt-2">
                <MudChip T="string" Size="Size.Large" Color="Color.Primary" Icon="@Icons.Material.Filled.Tag">
                    @_club.JoinCode
                </MudChip>
                <MudTooltip Text="Zkopírovat kód">
                    <MudIconButton Icon="@Icons.Material.Filled.ContentCopy" Size="Size.Small"
                                   OnClick="CopyCode" />
                </MudTooltip>
                <MudTooltip Text="Regenerovat kód (staré kódy přestanou fungovat)">
                    <MudIconButton Icon="@Icons.Material.Filled.Refresh" Size="Size.Small" Color="Color.Warning"
                                   OnClick="RegenerateCode" />
                </MudTooltip>
            </div>
            <MudText Typo="Typo.caption" Class="mud-text-secondary mt-1">
                Sdílejte tento kód — členové vstoupí přes /join
            </MudText>
        </MudCardContent>
    </MudCard>

    @* Pozvat emailem *@
    <MudCard Class="mb-4">
        <MudCardContent>
            <MudText Typo="Typo.subtitle1" GutterBottom="true">Pozvat e-mailem</MudText>
            <EditForm Model="@_invModel" OnValidSubmit="SendInvite">
                <DataAnnotationsValidator />
                <MudGrid>
                    <MudItem xs="12" sm="5">
                        <MudTextField Label="Email" @bind-Value="_invModel.Email" Variant="Variant.Outlined"
                                      For="@(() => _invModel.Email)" />
                    </MudItem>
                    <MudItem xs="12" sm="4">
                        <MudSelect Label="Role" @bind-Value="_invModel.Role" Variant="Variant.Outlined">
                            @foreach (var role in Enum.GetValues<OrgRole>())
                            {
                                <MudSelectItem Value="@role">@role</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="12" sm="3" Class="d-flex align-end">
                        <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary"
                                   FullWidth="true" Disabled="_invSending">
                            Pozvat
                        </MudButton>
                    </MudItem>
                </MudGrid>
            </EditForm>
        </MudCardContent>
    </MudCard>

    @* Seznam členů *@
    <MudTable Items="_members" Hover="true" Striped="true" Dense="true" Breakpoint="Breakpoint.Sm">
        <HeaderContent>
            <MudTh>Uživatel</MudTh>
            <MudTh>Email</MudTh>
            <MudTh>Role</MudTh>
            <MudTh>Od</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Uživatel">@(context.UserName ?? "—")</MudTd>
            <MudTd DataLabel="Email">@(context.Email ?? "—")</MudTd>
            <MudTd DataLabel="Role"><MudChip T="string" Size="Size.Small">@context.Role</MudChip></MudTd>
            <MudTd DataLabel="Od">@context.JoinedAt.ToLocalTime().ToString("d. M. yyyy")</MudTd>
        </RowTemplate>
        <NoRecordsContent>
            <MudText Class="mud-text-secondary">Oddíl nemá žádné členy.</MudText>
        </NoRecordsContent>
    </MudTable>

    @* Čekající pozvánky *@
    @if (_pendingInvitations.Any())
    {
        <MudText Typo="Typo.subtitle1" Class="mt-4 mb-2">Čekající pozvánky</MudText>
        <MudTable Items="_pendingInvitations" Dense="true" Breakpoint="Breakpoint.Sm">
            <HeaderContent>
                <MudTh>Email</MudTh>
                <MudTh>Role</MudTh>
                <MudTh>Vyprší</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd>@context.Email</MudTd>
                <MudTd>@context.Role</MudTd>
                <MudTd>@context.ExpiresAt.ToLocalTime().ToString("d. M. yyyy HH:mm")</MudTd>
            </RowTemplate>
        </MudTable>
    }
}

@code {
    [Parameter] public int ClubId { get; set; }

    private Club? _club;
    private List<MemberRow> _members = [];
    private List<Invitation> _pendingInvitations = [];
    private InviteModel _invModel = new();
    private bool _invSending;
    private string _userId = "";

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthState.GetAuthenticationStateAsync();
        _userId = auth.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value ?? "";
        await LoadData();
    }

    private async Task LoadData()
    {
        _club = await Db.Clubs.Include(c => c.Organization).FirstOrDefaultAsync(c => c.Id == ClubId);
        if (_club is null) return;

        var rawMembers = await (
            from cm in Db.ClubMembers
            join om in Db.OrganizationMembers on cm.OrganizationMemberId equals om.Id
            join u in Db.Users on om.UserId equals u.Id
            where cm.ClubId == ClubId && cm.IsActive
            select new { u.UserName, u.Email, om.Role, cm.JoinedAt }
        ).ToListAsync();
        _members = rawMembers.Select(x => new MemberRow(x.UserName, x.Email, x.Role, x.JoinedAt)).ToList();

        _pendingInvitations = await Db.Invitations
            .Where(i => i.ClubId == ClubId && i.AcceptedAt == null && i.ExpiresAt > DateTime.UtcNow)
            .ToListAsync();
    }

    private async Task SendInvite()
    {
        _invSending = true;
        await InvSvc.CreateInvitationAsync(_invModel.Email, ClubId, _invModel.Role, _userId);
        Snackbar.Add($"Pozvánka odeslána na {_invModel.Email}", MudBlazor.Severity.Success);
        _invModel = new();
        _invSending = false;
        await LoadData();
    }

    private async Task RegenerateCode()
    {
        if (_club is null) return;
        _club.JoinCode = Guid.NewGuid().ToString("N")[..8].ToUpper();
        await Db.SaveChangesAsync();
        Snackbar.Add("Kód byl regenerován.", MudBlazor.Severity.Info);
    }

    private Task CopyCode()
    {
        Snackbar.Add($"Kód: {_club?.JoinCode}", MudBlazor.Severity.Info);
        return Task.CompletedTask;
    }

    record MemberRow(string? UserName, string? Email, OrgRole Role, DateTime JoinedAt);

    class InviteModel
    {
        [System.ComponentModel.DataAnnotations.Required,
         System.ComponentModel.DataAnnotations.EmailAddress]
        public string Email { get; set; } = "";
        public OrgRole Role { get; set; } = OrgRole.Member;
    }
}
